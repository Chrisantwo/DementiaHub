# ─── DementiaHub Dashboard — Environment Configuration Template ─────────────
#
# Copy this file to `.env` for local development. The real `.env` is gitignored.
# In production (Railway), set these values in the Variables tab — never commit
# real secrets to git.
#
# Variables marked [required-prod] cause the server to refuse to start in
# production if missing. In dev they fall back to a random per-process value
# with a warning, so the server still runs but sessions/secrets don't persist.

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─── Auth & Sessions ────────────────────────────────────────────────────────
# [required-prod] Used to sign session JWTs. Use `openssl rand -hex 32` in prod.
# In dev, any non-empty string works.
JWT_SECRET=

# Comma-separated allowlists. Users whose email matches are granted the role
# on registration AND on each successful login (one-way upgrade).
ADMIN_EMAILS=
STAFF_EMAILS=

# ─── Database ───────────────────────────────────────────────────────────────
# MySQL connection string. Format: mysql://user:pass@host:3306/dbname
DATABASE_URL=

# ─── GoHighLevel (GHL) Integration ──────────────────────────────────────────
GHL_API_KEY=
GHL_LOCATION_ID=
# Optional: override the default cases pipeline ID
GHL_CASES_PIPELINE_ID=

# ─── ElevenLabs Voice Agent ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# [required-prod] Webhook signing secrets. ElevenLabs signs inbound webhooks
# with these. Set EITHER the per-event secrets OR the single fallback.
ELEVENLABS_POSTCALL_WEBHOOK_SECRET=
ELEVENLABS_CONSENT_WEBHOOK_SECRET=
# Fallback used by both if the per-event secrets are unset
ELEVENLABS_WEBHOOK_SECRET=

# ─── Voice QA Guardrails ────────────────────────────────────────────────────
# When true, outbound voice calls are restricted to the approved number list
VOICE_QA_MODE=true
# Comma-separated phone numbers allowed for QA outbound calls (E.164 format)
QA_APPROVED_PHONE_NUMBERS=

# ─── Built-in Forge (optional file storage / LLM proxy) ─────────────────────
# Only needed if file upload / external LLM features are used
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
